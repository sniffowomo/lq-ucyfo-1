{"id":"418f852e5b76f7562eca6fc64c6f3f38","source_id_to_path":{"0":"src/SimpleStorage.sol","1":"src/booty.sol"},"language":"Solidity","_format":"ethers-rs-sol-build-info-1","input":{"version":"0.8.28","language":"Solidity","sources":{"src/SimpleStorage.sol":{"content":"// Source - https://github.com/Cyfrin/foundry-simple-storage-cu/blob/main/src/SimpleStorage.sol\n\n// SPDX-License-Identifier: SmellPanty\npragma solidity ^0.8.19;\n\nimport \"./booty.sol\";\n\n// Initial Contract\ncontract SimpleStorage {\n    // Storage for the favNum\n    uint256 myFavNum;\n\n    // Person Struct which will be reused\n    struct Person {\n        uint256 favNum;\n        string name;\n    }\n\n    // Init person struct\n    Person[] public listofPeople;\n\n    // Maps the name to the favNum\n    mapping(string => uint256) public nameToFavNum;\n\n    // Storage Function of favnum\n    function store(uint256 _myFavNum) public {\n        myFavNum = _myFavNum;\n    }\n\n    // Retrieveal function\n    function retrieve() public view returns (uint256) {\n        return myFavNum;\n    }\n\n    // Function for adding person\n    function addPerson(string memory _name, uint256 _favNum) public {\n        listofPeople.push(Person(_favNum, _name));\n        nameToFavNum[_name] = _favNum;\n    }\n}\n"},"src/booty.sol":{"content":"// Booty.sol gfx\n\n// SPDX-License-Identifier: SmellPanty\npragma solidity ^0.8.19;\n\n// ╔══════════════════════════════════════════════════════════════════════════════╗\n// ║,,,'.'....     ..        ...:cccc...'';l0Od...  ............  ...;,':KK0000000║\n// ║:,,....',..'.            ....:clc...',coxl;................   ':.':;c000000000║\n// ║:;,.. .:',,l'::'.            .;l: ..':lo,......lx.,'........ .ckocloco00000000║\n// ║l;,. .::;:l:xOxo;..       ....... .':llo.,,..;kK0';cc,.....';lxkkxxdlclO000O00║\n// ║o:,..;ddodlxOdX0c'..    ........  .,ooool:l.c0000,:lol,...';xkOOkxxdl:;lO0000O║\n// ║dc,.;odxoodkOd00o:.'   .''';:'... 'ldddxkdkc0000O;:::c;...,colcc:,..'coxlll